# Everything is tracked unless listed here.
# appdata/ is the exception: it holds databases, caches and media, so only
# hand-written config files are allowlisted at the bottom.

########################### SECRETS - never commit
.env
!.env.example
secrets/

########################### LOCAL STATE
backups/
logs/
.claude/
*.bak

########################### APPDATA (allowlist)
appdata/*

!appdata/traefik3/
appdata/traefik3/*
!appdata/traefik3/rules/
!appdata/traefik3/rules/*/
!appdata/traefik3/rules/*/*.yml

!appdata/authelia/
appdata/authelia/*
!appdata/authelia/configuration.yml

!appdata/crowdsec/
appdata/crowdsec/*
!appdata/crowdsec/config/
appdata/crowdsec/config/*
!appdata/crowdsec/config/*.yaml
!appdata/crowdsec/config/parsers/
appdata/crowdsec/config/parsers/*
!appdata/crowdsec/config/parsers/s02-enrich/
appdata/crowdsec/config/parsers/s02-enrich/*
!appdata/crowdsec/config/parsers/s02-enrich/whitelist.yaml
!appdata/crowdsec/config/postoverflows/
appdata/crowdsec/config/postoverflows/*
!appdata/crowdsec/config/postoverflows/s01-whitelist/
appdata/crowdsec/config/postoverflows/s01-whitelist/*
!appdata/crowdsec/config/postoverflows/s01-whitelist/ddns-whitelist.yaml

!appdata/homeassistant/
appdata/homeassistant/*
!appdata/homeassistant/*.yaml
appdata/homeassistant/secrets.yaml

!appdata/homepage/
appdata/homepage/*
!appdata/homepage/*.yaml
!appdata/homepage/*.css
!appdata/homepage/*.js

!appdata/frigate/
appdata/frigate/*
!appdata/frigate/config/
appdata/frigate/config/*
!appdata/frigate/config/config.yml

!appdata/mosquitto/
appdata/mosquitto/*
!appdata/mosquitto/config/
appdata/mosquitto/config/*
!appdata/mosquitto/config/*.conf

!appdata/telegraf/
appdata/telegraf/*
!appdata/telegraf/config/
appdata/telegraf/config/*
!appdata/telegraf/config/*.conf

########################### SECRETS inside allowlisted folders (must stay last)
appdata/homeassistant/secrets.yaml
appdata/authelia/users.yml
appdata/crowdsec/config/*_api_credentials.yaml
