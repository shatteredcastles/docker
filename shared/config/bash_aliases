# Shell shortcuts for any host running this repo.
# Source from ~/.bashrc:
#   [ -f "$HOME/docker/shared/config/bash_aliases" ] && . "$HOME/docker/shared/config/bash_aliases"
# Set DOCKER_DIR before sourcing if the repo isn't at ~/docker.

DOCKER_DIR="${DOCKER_DIR:-$HOME/docker}"

########################### DOCKER COMPOSE (this host's stack)
alias dc='docker compose --project-directory "$DOCKER_DIR"'
alias dcup='dc up -d'                      # dcup [service...]  start/apply changes
alias dcdown='dc down'                     # stop and remove the whole stack
alias dcrec='dc up -d --force-recreate'    # dcrec service...   recreate
alias dcstop='dc stop'                     # dcstop [service...]
alias dcrestart='dc restart'               # dcrestart [service...]
alias dcpull='dc pull'                     # dcpull [service...]
alias dclogs='dc logs -f --tail=100'       # dclogs [service...]
alias dcps='dc ps --format "table {{.Name}}\t{{.State}}\t{{.Status}}"'
alias dccheck='dc config -q && echo "compose config OK"'
alias dcplan='dc up -d --dry-run 2>&1 | grep -E "Recreate|Create |Remov" | grep -v "d $"'  # what dcup would change
alias dcupdate='"$DOCKER_DIR/scripts/hs/update-containers.sh"'  # run the weekly auto-update now

########################### DOCKER
alias dps='docker ps -a --format "table {{.Names}}\t{{.State}}\t{{.Status}}\t{{.Image}}" | (sed -u 1q; sort)'
alias dexec='docker exec -ti'              # dexec container [sh]
alias dlogs='docker logs -tf --tail=50'    # dlogs container
alias ddf='docker system df'
alias dprune='docker image prune -a'       # remove unused images (asks first)

########################### CROWDSEC
alias cscli='docker exec crowdsec cscli'
alias csdecisions='cscli decisions list'
alias csalerts='cscli alerts list'
alias csinspect='cscli alerts inspect -d'  # csinspect <alert id>
alias csmetrics='cscli metrics'
alias csbouncers='cscli bouncers list'
alias csallow='cscli allowlists inspect temp-allowlist'
alias temp-unban='"$DOCKER_DIR/scripts/hs/temp-unban.sh"'  # temp-unban <ip> [duration=168h] [comment]
alias csfbstatus='sudo systemctl status crowdsec-firewall-bouncer.service'
alias csfbrestart='sudo systemctl restart crowdsec-firewall-bouncer.service'

########################### REPO
alias cddocker='cd "$DOCKER_DIR"'
alias envexample='"$DOCKER_DIR/scripts/gen-env-example.sh"'
